# =============================================================================
# Nexora Business Suite — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure your values.
# NEVER commit real credentials or .env to source control.

# Server Environment (development | test | production)
NODE_ENV="development"
PORT=3000

# PostgreSQL Database Connection URL
# Production format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora_db?schema=public"

# Auth.js / NextAuth v5 Configuration
# In production, generate a cryptographically strong secret using: `openssl rand -base64 32`
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Demo Database Seeding (Optional — used only by `npm run db:seed`)
SEED_DEFAULT_PASSWORD="Password123!"
