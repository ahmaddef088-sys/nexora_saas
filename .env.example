# =============================================================================
# Nexora Business Suite — Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development and fill in your own values.
# NEVER commit real credentials or .env to source control.
# All values below are placeholders, not real secrets.
#
# ---------------------------------------------------------------------------
# VERCEL (Project Settings -> Environment Variables) — REQUIRED in production:
#   DATABASE_URL
#   AUTH_SECRET            (or NEXTAUTH_SECRET — one of the two is required)
# VERCEL — OPTIONAL:
#   AUTH_URL / NEXTAUTH_URL  Not needed on Vercel (trustHost is enabled and the
#                            host is detected automatically). Only set it if
#                            you need to force a specific canonical URL.
#   SEED_DEFAULT_PASSWORD    Initial password for invited users created via
#                            the Users screen and for `npm run db:seed`.
#                            Strongly recommended in production.
# NODE_ENV and PORT are set automatically by Vercel — do NOT add them there.
# ---------------------------------------------------------------------------

# Server Environment (development | test | production) — local only
NODE_ENV="development"
PORT=3000

# PostgreSQL Database Connection URL (read by Prisma via env("DATABASE_URL"))
# Production format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nexora_db?schema=public"

# Auth.js / NextAuth v5 secret used to sign/encrypt session JWTs.
# Generate with: `openssl rand -base64 32`  (or `npx auth secret`)
AUTH_SECRET="replace-with-a-long-random-secret"
# Legacy name, still supported as a fallback if AUTH_SECRET is not set.
# NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Canonical app URL (optional; required only behind non-standard proxies)
# AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Default password for seeded demo accounts and newly invited users (optional)
SEED_DEFAULT_PASSWORD="replace-with-a-strong-initial-password"
